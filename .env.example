# Salin file ini jadi ".env" lalu isi nilainya.
# JANGAN isi token/key asli di file ini - file ini ikut ter-upload ke GitHub.
DISCORD_TOKEN=isi_token_bot_discord_kamu

# Otak AI: "gemini" (gratis) atau "claude" (berbayar)
AI_PROVIDER=gemini

# Wajib kalau AI_PROVIDER=gemini. Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_gemini_kamu
# Model dicoba berurutan; yang berikutnya dipakai kalau yang pertama penuh/error
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash

# Wajib kalau AI_PROVIDER=claude. Ambil di https://console.anthropic.com
# ANTHROPIC_API_KEY=isi_api_key_anthropic_kamu
# CLAUDE_MODEL=claude-opus-5-5

# Channel tempat bot membalas semua pesan tanpa di-mention
FREE_CHAT_CHANNEL=ngobrol-sama-bot
